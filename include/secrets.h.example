// Copie este arquivo para "secrets.h" e preencha com seus dados reais.
// NUNCA suba o secrets.h de verdade para um repositório público.

#pragma once

// --- Wi-Fi ---
#define WIFI_SSID     "SEU_WIFI"
#define WIFI_PASSWORD "SUA_SENHA"

// --- Zabbix ---
// URL completa até o api_jsonrpc.php, ex: http://192.168.1.10/zabbix/api_jsonrpc.php
#define ZABBIX_API_URL "http://SEU_ZABBIX/zabbix/api_jsonrpc.php"

// Recomendado (Zabbix 5.4+): crie um API token em
// Administração > Usuários > Tokens de API, com um usuário só de LEITURA.
// Deixe como "" se for usar usuário/senha em vez de token.
#define ZABBIX_API_TOKEN "COLE_SEU_TOKEN_AQUI"

// Alternativa (se não usar token): usuário/senha de um usuário read-only
#define ZABBIX_USER "monitor-readonly"
#define ZABBIX_PASS ""
